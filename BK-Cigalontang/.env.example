# Google Gemini API Configuration
# Dapatkan di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenAI (ChatGPT) — untuk generate gambar dengan GPT Image
# Dapatkan di: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here

# Generator gambar konten Instagram (konten-instagram/tools/generate-gambar.js)
# Provider default: gemini | openai
IMAGE_PROVIDER=gemini
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# OPENAI_IMAGE_MODEL=gpt-image-1

# Server Configuration
PORT=3001
NODE_ENV=development
